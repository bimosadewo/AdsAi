# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# Lihat docs/FASE-0-AKSES.md untuk cara mendapatkan setiap nilai.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ID akun Manager (MCC), tanpa tanda strip. Contoh: 1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# (Opsional) Akun klien default bila customer_id tidak disebut. Contoh: 5827572362
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=

# ---------- Pengaman (Fase 2) ----------
# true = matikan semua tool yang mengubah akun
ADSAI_READ_ONLY=false
# Budget harian maksimum yang boleh diset lewat AdsAi (mata uang akun). Kosong = tanpa batas.
ADSAI_MAX_DAILY_BUDGET=1000000
# Kenaikan budget maksimum dalam satu perubahan (2 = maksimal 2x lipat)
ADSAI_MAX_BUDGET_INCREASE_FACTOR=2
# Folder log audit perubahan (default: ./logs)
ADSAI_AUDIT_LOG_DIR=

# ---------- Klien & notifikasi (Fase 3) ----------
# Lokasi file daftar klien (default: ./clients.yaml, lihat clients.example.yaml)
ADSAI_CLIENTS_FILE=
